        /* =====================================
           ID
           ===================================== */

        function makeId(value) {

            return value

                .replace(/\([^)]*\)/g, '')

                .normalize('NFD')

                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )

                .toLowerCase()

                .trim()

                .replace(/\s+/g, '-')

                .replace(/[^a-z0-9-]/g, '')

                .replace(/-{2,}/g, '-');

        }


        function suggestAvailableId(baseId) {

            if (!baseId) {
                return '';
            }

            if (!existingIds.has(baseId)) {
                return baseId;
            }

            let number = 2;

            while (
                existingIds.has(
                    `${baseId}-${number}`
                )
            ) {
                number += 1;
            }

            return `${baseId}-${number}`;

        }


        function updateAutomaticId() {

            const baseId =
                makeId(headword.value);

            const suggestedId =
                suggestAvailableId(baseId);

            idInput.value =
                suggestedId;


            if (
                baseId &&
                baseId !== suggestedId
            ) {
                idMessage.className =
                    'field-help warning';

                idMessage.textContent =
                    `基础 ID "${baseId}" 已存在，` +
                    `已建议使用 "${suggestedId}"。`;
            }
            else if (suggestedId) {
                idMessage.className =
                    'field-help valid';

                idMessage.textContent =
                    `✓ ID "${suggestedId}" 当前可用。`;
            }
            else {
                idMessage.className =
                    'field-help';

                idMessage.textContent =
                    '根据词头自动建议，可手动修改。';
            }

        }


        function updateManualIdMessage() {

            const value =
                idInput.value.trim();

            if (!value) {
                idMessage.className =
                    'field-help';

                idMessage.textContent =
                    'ID 不能为空。';

                return;
            }

            if (
                !/^[a-z0-9-]+$/.test(value)
            ) {
                idMessage.className =
                    'field-help warning';

                idMessage.textContent =
                    'ID 只能包含小写 ASCII 字母、数字和短杠。';

                return;
            }

            if (existingIds.has(value)) {
                idMessage.className =
                    'field-help warning';

                idMessage.textContent =
                    `ID "${value}" 已存在。`;

                return;
            }

            idMessage.className =
                'field-help valid';

            idMessage.textContent =
                `✓ ID "${value}" 当前可用。`;

        }


