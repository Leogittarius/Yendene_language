---
import dictionary from '@data/dictionary.json';

const lookupEntries = dictionary.entries.map((entry) => ({
    id: entry.id,
    headword: entry.headword,
    pos: entry.pos ?? [],

    senses: (entry.senses ?? []).map((sense) => ({
        definition: sense.definition ?? '',
        gloss: sense.gloss ?? '',
    })),

    definitions: (entry.senses ?? [])
        .map((sense) => sense.definition)
        .filter(Boolean),

    glosses: (entry.senses ?? [])
        .map((sense) => sense.gloss)
        .filter(Boolean),

    variants: (entry.variants ?? [])
        .map((variant) =>
            typeof variant === 'string'
                ? variant
                : variant.form
        )
        .filter(Boolean),
}));

const lookupJson =
    JSON.stringify(lookupEntries)
        .replace(/</g, '\\u003c');
---

<div class="entry-builder">

    <div class="builder-form">

        <!-- =====================================
             Basic information
             ===================================== -->

        <section class="builder-section">
            <h2>基本信息</h2>

            <label class="field">
                <span class="field-label">词头</span>

                <input
                    id="eb-headword"
                    type="text"
                    placeholder="例如：nu(-e)"
                />
            </label>


            <div class="field">
                <span class="field-label">ID</span>

                <div class="id-row">
                    <input
                        id="eb-id"
                        type="text"
                        placeholder="自动生成"
                    />

                    <button
                        id="eb-regenerate-id"
                        class="small-button"
                        type="button"
                    >
                        重新生成
                    </button>
                </div>

                <span
                    id="eb-id-message"
                    class="field-help"
                >
                    根据词头自动建议，可手动修改。
                </span>
            </div>


            <label class="field">
                <span class="field-label">条目类型</span>

                <select id="eb-type">
                    <option value="word">
                        word — 词
                    </option>

                    <option value="affix">
                        affix — 词缀
                    </option>

                    <option value="root">
                        root — 词根
                    </option>

                    <option value="clitic">
                        clitic — 附着词
                    </option>

                    <option value="phrase">
                        phrase — 短语
                    </option>
                </select>
            </label>


            <div class="field">
                <span class="field-label">词性</span>

                <div class="checkbox-grid">

                    <label>
                        <input type="checkbox" name="pos" value="noun" />
                        <span>n. 普通名词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="verb" />
                        <span>v. 普通动态动词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="stative" />
                        <span>stat. 状态动词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="numeral" />
                        <span>num. 数量状态动词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="pronoun" />
                        <span>pron. 代词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="function" />
                        <span>func. 普通功能词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="lightverb" />
                        <span>lv. 轻动词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="particle" />
                        <span>part. 构式粒子</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="affix" />
                        <span>aff. 普通派生词缀</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="converb" />
                        <span>conv. 副动词后缀</span>
                    </label>

                </div>
            </div>


            <label class="field">
                <span class="field-label">状态</span>

                <select id="eb-status">
                    <option value="established">
                        established — 已确定
                    </option>

                    <option value="draft">
                        draft — 草案
                    </option>

                    <option value="deprecated">
                        deprecated — 已废弃
                    </option>
                </select>
            </label>
        </section>


        <!-- =====================================
             Senses
             ===================================== -->

        <section class="builder-section">
            <div class="section-header">
                <h2>义项</h2>

                <button
                    id="eb-add-sense"
                    class="small-button"
                    type="button"
                >
                    ＋ 添加义项
                </button>
            </div>

            <div id="eb-sense-list"></div>
        </section>


        <!-- =====================================
             Formation
             ===================================== -->

        <section class="builder-section">
            <h2>构词</h2>

            <label class="field">
                <span class="field-label">构词类型</span>

                <select id="eb-formation-type">
                    <option value="simple">
                        simple — 单纯形式
                    </option>

                    <option value="root">
                        root — 词根
                    </option>

                    <option value="derived">
                        derived — 派生
                    </option>

                    <option value="compound">
                        compound — 复合
                    </option>

                    <option value="reduplicated">
                        reduplicated — 重叠
                    </option>

                    <option value="ideophonic">
                        ideophonic — 拟声 / 表意
                    </option>

                    <option value="opaque">
                        opaque — 构词不透明
                    </option>

                    <option value="borrowed">
                        borrowed — 借词
                    </option>
                </select>
            </label>


            <label class="field">
                <span class="field-label">构词分析</span>

                <input
                    id="eb-analysis"
                    type="text"
                    placeholder="例如：ma-talge"
                />

                <span class="field-help">
                    analysis 只是显示用字符串，不参与词条引用。
                </span>
            </label>


            <div
                id="eb-component-block"
                class="component-block"
            >
                <div class="section-header component-header">
                    <div>
                        <span class="field-label">
                            构词成分
                        </span>

                        <span class="field-help">
                            ref 默认使用词条的 ID，而不是显示词形。
                            可以搜索现有词条，也可以建立暂未收录的 ID。
                        </span>
                    </div>

                    <button
                        id="eb-add-component"
                        class="small-button"
                        type="button"
                    >
                        ＋ 添加成分
                    </button>
                </div>

                <div id="eb-component-list"></div>
            </div>
        </section>


        <!-- =====================================
             Examples
             ===================================== -->

        <section class="builder-section">

            <div class="section-header">

                <div>
                    <h2>例句</h2>

                    <span class="field-help">
                        每个例句由若干分析成分组成。
                        词典词条负责提供基本 Gloss，
                        句中形式由你填写，语法特征将自动附加到 Gloss。
                    </span>
                </div>

                <button
                    id="eb-add-example"
                    class="small-button"
                    type="button"
