</style>


<script>

    function initialiseEntryBuilder() {

        const root =
            document.querySelector('.entry-builder');

        if (!root) return;


        /* =====================================
           Existing dictionary
           ===================================== */

        const dataScript =
            document.querySelector(
                '#eb-existing-entries'
            );

        const existingEntries =
            JSON.parse(
                dataScript?.textContent ?? '[]'
            );

        const existingIds =
            new Set(
                existingEntries.map(
                    (entry) => entry.id
                )
            );


        /* =====================================
           Elements
           ===================================== */

        const headword =
            root.querySelector('#eb-headword');

        const idInput =
            root.querySelector('#eb-id');

        const idMessage =
            root.querySelector('#eb-id-message');

        const regenerateId =
            root.querySelector(
                '#eb-regenerate-id'
            );

        const type =
            root.querySelector('#eb-type');

        const status =
            root.querySelector('#eb-status');

        const formationType =
            root.querySelector(
                '#eb-formation-type'
            );

        const analysis =
            root.querySelector('#eb-analysis');

        const senseList =
            root.querySelector(
                '#eb-sense-list'
            );

        const addSenseButton =
            root.querySelector(
                '#eb-add-sense'
            );

        const componentBlock =
            root.querySelector(
                '#eb-component-block'
            );

        const componentList =
            root.querySelector(
                '#eb-component-list'
            );

        const addComponentButton =
            root.querySelector(
                '#eb-add-component'
            );

        const ipa =
            root.querySelector('#eb-ipa');

        const etymology =
            root.querySelector('#eb-etymology');

        const notes =
            root.querySelector('#eb-notes');

        const output =
            root.querySelector('#eb-output');

        const validation =
            root.querySelector(
                '#eb-validation'
            );

        const copyButton =
            root.querySelector('#eb-copy');


        let idEditedManually = false;


        /* =====================================
           ID
           ===================================== */

        function makeId(value) {

            return value

                .replace(/\([^)]*\)/g, '')

                .normalize('NFD')

                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )

                .toLowerCase()

                .trim()

                .replace(/\s+/g, '-')

                .replace(/[^a-z0-9-]/g, '')

                .replace(/-{2,}/g, '-');

        }


        function suggestAvailableId(baseId) {

            if (!baseId) {
                return '';
            }

            if (!existingIds.has(baseId)) {
                return baseId;
            }

            let number = 2;

            while (
                existingIds.has(
                    `${baseId}-${number}`
                )
            ) {
                number += 1;
            }

            return `${baseId}-${number}`;

        }


        function updateAutomaticId() {

            const baseId =
                makeId(headword.value);

            const suggestedId =
                suggestAvailableId(baseId);

            idInput.value =
                suggestedId;


            if (
                baseId &&
                baseId !== suggestedId
            ) {
                idMessage.className =
                    'field-help warning';

                idMessage.textContent =
                    `基础 ID "${baseId}" 已存在，` +
                    `已建议使用 "${suggestedId}"。`;
            }
            else if (suggestedId) {
                idMessage.className =
                    'field-help valid';

                idMessage.textContent =
                    `✓ ID "${suggestedId}" 当前可用。`;
            }
            else {
                idMessage.className =
                    'field-help';

                idMessage.textContent =
                    '根据词头自动建议，可手动修改。';
            }

        }


        function updateManualIdMessage() {

            const value =
                idInput.value.trim();

            if (!value) {
                idMessage.className =
                    'field-help';

                idMessage.textContent =
                    'ID 不能为空。';

                return;
            }

            if (
                !/^[a-z0-9-]+$/.test(value)
            ) {
                idMessage.className =
                    'field-help warning';

                idMessage.textContent =
                    'ID 只能包含小写 ASCII 字母、数字和短杠。';

                return;
            }

            if (existingIds.has(value)) {
                idMessage.className =
                    'field-help warning';

                idMessage.textContent =
                    `ID "${value}" 已存在。`;

                return;
            }

            idMessage.className =
                'field-help valid';

            idMessage.textContent =
                `✓ ID "${value}" 当前可用。`;

        }


        /* =====================================
           Senses
           ===================================== */

        function refreshSenseNumbers() {

            const items =
                Array.from(
                    senseList.querySelectorAll(
                        '.sense-item'
                    )
                );

            items.forEach(
                (item, index) => {

                    item.querySelector(
                        '.dynamic-item-title'
                    ).textContent =
                        `义项 ${index + 1}`;

                    const deleteButton =
                        item.querySelector(
                            '.delete-sense'
                        );

                    deleteButton.disabled =
                        items.length === 1;

                }
            );

        }


        function addSense(
            definition = '',
            gloss = ''
        ) {

            const item =
                document.createElement('div');

            item.className =
                'dynamic-item sense-item';

            item.innerHTML = `
                <div class="dynamic-item-header">
                    <span class="dynamic-item-title"></span>

                    <button
                        type="button"
                        class="delete-button delete-sense"
                    >
                        删除
                    </button>
                </div>

                <div class="sense-fields">

                    <label class="field">
                        <span class="field-label">
                            释义
                        </span>

                        <textarea
                            class="sense-definition"
                            rows="2"
                            placeholder="例如：狗，犬"
                        ></textarea>
                    </label>

                    <label class="field">
                        <span class="field-label">
                            Gloss
                        </span>

                        <input
                            class="sense-gloss"
                            type="text"
                            placeholder="例如：狗"
                        />
                    </label>

                </div>
            `;

            item.querySelector(
                '.sense-definition'
            ).value = definition;

            item.querySelector(
                '.sense-gloss'
            ).value = gloss;

            senseList.appendChild(item);

            refreshSenseNumbers();
            update();

        }


        /* =====================================
           Components
           ===================================== */

        function normalizeSearch(value) {

            return String(value)
                .normalize('NFD')
                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )
                .toLowerCase()
                .trim();

        }


        function getEntrySearchText(entry) {

            return normalizeSearch([
                entry.id,
                entry.headword,
                ...(entry.definitions ?? []),
                ...(entry.glosses ?? []),
            ].join(' '));

        }


        function setComponentStatus(
            item,
            message,
            state = ''
        ) {

            const statusElement =
                item.querySelector(
                    '.component-status'
                );

            statusElement.className =
                `component-status ${state}`;

            statusElement.textContent =
                message;

        }


        function selectExistingComponent(
            item,
            entry
        ) {

            item.dataset.ref =
                entry.id;

            const search =
                item.querySelector(
                    '.component-search'
                );

            const form =
                item.querySelector(
                    '.component-form'
                );

            search.value =
                entry.headword;

            if (!form.value.trim()) {
                form.value =
                    entry.headword;
            }

            setComponentStatus(
                item,
                `✓ 已选择 ID: ${entry.id}`,
                'valid'
            );

            item.querySelector(
                '.component-results'
            ).hidden = true;

            update();

        }


        function selectPendingComponent(
            item,
            rawValue
        ) {

            const ref =
                makeId(rawValue);

            if (!ref) return;

            item.dataset.ref =
                ref;

            const form =
                item.querySelector(
                    '.component-form'
                );

            if (!form.value.trim()) {
                form.value =
                    rawValue.trim();
            }

            setComponentStatus(
                item,
                `⚠ 暂未收录 ID: ${ref}`,
                'warning'
            );

            item.querySelector(
                '.component-results'
            ).hidden = true;

            update();

        }


        function renderComponentResults(
            item,
            rawQuery
        ) {

            const container =
                item.querySelector(
                    '.component-results'
                );

            container.innerHTML = '';

            const query =
                normalizeSearch(rawQuery);

            if (!query) {
                container.hidden = true;
                return;
            }


            const matches =
                existingEntries
                    .filter((entry) =>
                        getEntrySearchText(entry)
                            .includes(query)
                    )
                    .slice(0, 8);


            matches.forEach((entry) => {

                const button =
                    document.createElement(
                        'button'
                    );

                button.type = 'button';
                button.className =
                    'component-result';

                const head =
                    document.createElement(
                        'span'
                    );

                head.className =
                    'result-head';

                const headword =
                    document.createElement(
                        'span'
                    );

                headword.className =
                    'result-headword';

                headword.textContent =
                    entry.headword;

                const id =
                    document.createElement(
                        'span'
                    );

                id.className =
                    'result-id';

                id.textContent =
                    `ID: ${entry.id}`;

                head.append(
                    headword,
                    id
                );

                button.appendChild(head);


                if (
                    entry.definitions?.[0]
                ) {
                    const description =
                        document.createElement(
                            'span'
                        );

                    description.className =
                        'result-description';

                    description.textContent =
                        entry.definitions[0];

                    button.appendChild(
                        description
                    );
                }


                button.addEventListener(
                    'click',
                    () => {
                        selectExistingComponent(
                            item,
                            entry
                        );
                    }
                );

                container.appendChild(
                    button
                );

            });


            const pendingId =
                makeId(rawQuery);

            if (
                pendingId &&
                !existingIds.has(pendingId)
            ) {

                const pendingButton =
                    document.createElement(
                        'button'
                    );

                pendingButton.type =
                    'button';

                pendingButton.className =
                    'component-result pending-result';

                pendingButton.textContent =
                    `＋ 使用 "${pendingId}" ` +
                    `作为暂未收录的 ID`;

                pendingButton.addEventListener(
                    'click',
                    () => {
                        selectPendingComponent(
                            item,
                            rawQuery
                        );
                    }
                );

                container.appendChild(
                    pendingButton
                );

            }


            if (
                container.children.length === 0
            ) {
                container.hidden = true;
                return;
            }

            container.hidden = false;

        }


        function addComponent() {

            const item =
                document.createElement('div');

            item.className =
                'dynamic-item component-item';

            item.dataset.ref = '';

            item.innerHTML = `
                <div class="dynamic-item-header">
                    <span class="dynamic-item-title">
                        构词成分
                    </span>

                    <button
                        type="button"
                        class="delete-button delete-component"
                    >
                        删除
                    </button>
                </div>

                <div class="component-fields">

                    <div class="field component-picker">

                        <span class="field-label">
                            引用词条
                        </span>

                        <input
                            class="component-search"
                            type="text"
                            autocomplete="off"
                            placeholder="搜索 ID、词形或释义……"
                        />

                        <span class="component-status">
                            尚未选择引用。
                        </span>

                        <div
                            class="component-results"
                            hidden
                        ></div>

                    </div>


                    <label class="field">

                        <span class="field-label">
                            实际形式
                        </span>

                        <input
                            class="component-form"
                            type="text"
                            placeholder="构词中实际出现的形式"
                        />

                    </label>

                </div>
            `;

            componentList.appendChild(
                item
            );

            update();

        }


        function updateComponentVisibility() {

            const type =
                formationType.value;

            const hidden =
                type === 'simple' ||
                type === 'root';

            componentBlock.hidden =
                hidden;

        }


        /* =====================================
           Build JSON
           ===================================== */

        function getSelectedPos() {

            return Array.from(
                root.querySelectorAll(
                    'input[name="pos"]:checked'
                )
            ).map(
                (checkbox) =>
                    checkbox.value
            );

        }


        function getSenses() {

            return Array.from(
                senseList.querySelectorAll(
                    '.sense-item'
                )
            )
            .map((item) => {

                const definition =
                    item.querySelector(
                        '.sense-definition'
                    ).value.trim();

                const gloss =
                    item.querySelector(
                        '.sense-gloss'
                    ).value.trim();


                if (
                    !definition &&
                    !gloss
                ) {
                    return null;
                }


                const sense = {
                    definition
                };

                if (gloss) {
                    sense.gloss =
                        gloss;
                }

                return sense;

            })
            .filter(Boolean);

        }


        function getComponents() {

            if (
                formationType.value ===
                    'simple' ||
                formationType.value ===
                    'root'
            ) {
                return [];
            }


            return Array.from(
                componentList.querySelectorAll(
                    '.component-item'
                )
            )
            .map((item) => {

                const ref =
                    item.dataset.ref ?? '';

                const form =
                    item.querySelector(
                        '.component-form'
                    ).value.trim();

                const search =
                    item.querySelector(
                        '.component-search'
                    ).value.trim();


                if (
                    !ref &&
                    !form &&
                    !search
                ) {
                    return null;
                }


                return {
                    ref,
                    form
                };

            })
            .filter(Boolean);

        }


        function buildEntry() {

            return {
                id:
                    idInput.value.trim(),

                headword:
                    headword.value.trim(),

                type:
                    type.value,

                pos:
                    getSelectedPos(),

                pronunciation: {
                    ipa:
                        ipa.value.trim()
                },

                senses:
                    getSenses(),

                formation: {
                    type:
                        formationType.value,

                    analysis:
                        analysis.value.trim(),

                    components:
                        getComponents()
                },

                etymology:
                    etymology.value.trim(),

                variants: [],

                relations: {
                    related: [],
                    synonyms: [],
                    antonyms: [],
                    derived: []
                },

                examples: [],

                status:
                    status.value,

                tags: [],

                notes:
                    notes.value.trim()
            };

        }


        /* =====================================
           Validation
           ===================================== */

        function validateEntry(entry) {

            const errors = [];


            if (!entry.headword) {
                errors.push(
                    '请填写词头。'
                );
            }


            if (!entry.id) {
                errors.push(
                    'ID 不能为空。'
                );
            }
            else if (
                !/^[a-z0-9-]+$/.test(
                    entry.id
                )
            ) {
                errors.push(
                    'ID 只能包含小写 ASCII 字母、数字和短杠。'
                );
            }
            else if (
                existingIds.has(
                    entry.id
                )
            ) {
                errors.push(
                    `ID "${entry.id}" 已存在。`
                );
            }


            if (
                entry.type !== 'root' &&
                entry.pos.length === 0
            ) {
                errors.push(
                    '请选择至少一个词性。'
                );
            }


            if (
                entry.senses.length === 0
            ) {
                errors.push(
                    '至少需要一个义项。'
                );
            }

            entry.senses.forEach(
                (sense, index) => {

                    if (!sense.definition) {
                        errors.push(
                            `义项 ${index + 1} ` +
                            `缺少释义。`
                        );
                    }

                }
            );


            entry.formation.components
                .forEach(
                    (component, index) => {

                        if (!component.ref) {
                            errors.push(
                                `构词成分 ` +
                                `${index + 1} ` +
                                `尚未选择 ref。`
                            );
                        }

                        if (!component.form) {
                            errors.push(
                                `构词成分 ` +
                                `${index + 1} ` +
                                `缺少实际形式。`
                            );
                        }

                    }
                );


            return errors;

        }


        function update() {

            const entry =
                buildEntry();

            const errors =
                validateEntry(entry);


            output.value =
                JSON.stringify(
                    entry,
                    null,
                    2
                );


            if (errors.length > 0) {

                validation.className =
                    'validation error';

                validation.textContent =
                    errors.join(' ');

                copyButton.disabled =
                    true;

                return;

            }


            validation.className =
                'validation valid';

            validation.textContent =
                '✓ 当前词条基本结构有效';

            copyButton.disabled =
                false;

        }


        /* =====================================
           Events
           ===================================== */

        headword.addEventListener(
            'input',
            () => {

                if (!idEditedManually) {
                    updateAutomaticId();
                }

                update();

            }
        );


        idInput.addEventListener(
            'input',
            () => {

                idEditedManually =
                    true;

                updateManualIdMessage();
                update();

            }
        );


        regenerateId.addEventListener(
            'click',
            () => {

                idEditedManually =
                    false;

                updateAutomaticId();
                update();

            }
        );


        addSenseButton.addEventListener(
            'click',
            () => {
                addSense();
            }
        );


        addComponentButton.addEventListener(
            'click',
            () => {
                addComponent();
            }
        );


        senseList.addEventListener(
            'click',
            (event) => {

                const button =
                    event.target.closest(
                        '.delete-sense'
                    );

                if (!button) return;

                const item =
                    button.closest(
                        '.sense-item'
                    );

                if (!item) return;

                item.remove();

                refreshSenseNumbers();
                update();

            }
        );


        componentList.addEventListener(
            'click',
            (event) => {

                const button =
                    event.target.closest(
                        '.delete-component'
                    );

                if (!button) return;

                const item =
                    button.closest(
                        '.component-item'
                    );

                if (!item) return;

                item.remove();

                update();

            }
        );


        componentList.addEventListener(
            'input',
            (event) => {

                const search =
                    event.target.closest(
                        '.component-search'
                    );

                if (search) {

                    const item =
                        search.closest(
                            '.component-item'
                        );

                    item.dataset.ref = '';

                    setComponentStatus(
                        item,
                        '尚未选择引用。'
                    );

                    renderComponentResults(
                        item,
                        search.value
                    );

                }

                update();

            }
        );


        root.addEventListener(
            'input',
            (event) => {

                if (
                    event.target ===
                        headword ||
                    event.target ===
                        idInput ||
                    event.target.closest(
                        '.component-search'
                    )
                ) {
                    return;
                }

                update();

            }
        );


        root.addEventListener(
            'change',
            (event) => {

                if (
                    event.target ===
                    formationType
                ) {
                    updateComponentVisibility();
                }

                update();

            }
        );


        document.addEventListener(
            'click',
            (event) => {

                if (
                    event.target.closest(
                        '.component-picker'
                    )
                ) {
                    return;
                }

                root
                    .querySelectorAll(
                        '.component-results'
                    )
                    .forEach(
                        (results) => {
                            results.hidden =
                                true;
                        }
                    );

            }
        );


        copyButton.addEventListener(
            'click',
            async () => {

                if (copyButton.disabled) {
                    return;
                }

                try {

                    await navigator.clipboard
                        .writeText(
                            output.value
                        );

                    const oldText =
                        copyButton.textContent;

                    copyButton.textContent =
                        '已复制';

                    window.setTimeout(
                        () => {
                            copyButton.textContent =
                                oldText;
                        },
                        1200
                    );

                }
                catch {

                    validation.className =
                        'validation error';

                    validation.textContent =
                        '复制失败，请手动复制 JSON。';

                }

            }
        );


        /* =====================================
           Initialise
           ===================================== */

        addSense();

        updateComponentVisibility();
        updateAutomaticId();
        update();

    }


    initialiseEntryBuilder();

</script>