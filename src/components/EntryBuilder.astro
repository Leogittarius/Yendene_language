                            placeholder="例如：狗，犬"
                        ></textarea>
                    </label>

                    <label class="field">
                        <span class="field-label">
                            Gloss
                        </span>

                        <input
                            class="sense-gloss"
                            type="text"
                            placeholder="自动取第一个释义"
                        />
                    </label>

                </div>
            `;


            const definitionInput =
                item.querySelector(
                    '.sense-definition'
                );

            const glossInput =
                item.querySelector(
                    '.sense-gloss'
                );


            definitionInput.value =
                definition;

            glossInput.value =
                gloss ||
                makeGlossFromDefinition(
                    definition
