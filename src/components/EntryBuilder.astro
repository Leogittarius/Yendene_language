        function normalizeSearch(value) {

            return String(value)
                .normalize('NFD')
                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )
                .toLowerCase()
                .trim();

        }



        function getEntrySearchText(entry) {

            return normalizeSearch([
                entry.id,
                entry.headword,
                ...(entry.definitions ?? []),
                ...(entry.glosses ?? []),
            ].join(' '));

        }


        function setComponentStatus(
            item,
            message,
            state = ''
        ) {

            const statusElement =
                item.querySelector(
                    '.component-status'
                );

            statusElement.className =
                `component-status ${state}`;

            statusElement.textContent =
                message;

        }


        function selectExistingComponent(
            item,
            entry
        ) {

            item.dataset.ref =
                entry.id;

            const search =
                item.querySelector(
                    '.component-search'
                );

            const form =
                item.querySelector(
                    '.component-form'
                );

            search.value =
                entry.headword;

            if (!form.value.trim()) {
                form.value =
                    entry.headword;
            }

            setComponentStatus(
                item,
                `✓ 已选择 ID: ${entry.id}`,
                'valid'
            );

            item.querySelector(
                '.component-results'
            ).hidden = true;

            update();

        }


        function selectPendingComponent(
            item,
            rawValue
        ) {

            const ref =
                makeId(rawValue);

            if (!ref) return;

            item.dataset.ref =
                ref;

            const form =
                item.querySelector(
                    '.component-form'
                );

            if (!form.value.trim()) {
                form.value =
                    rawValue.trim();
            }

            setComponentStatus(
                item,
                `⚠ 暂未收录 ID: ${ref}`,
                'warning'
            );

            item.querySelector(
                '.component-results'
            ).hidden = true;

            update();

        }


        function renderComponentResults(
            item,
            rawQuery
        ) {

            const container =
                item.querySelector(
                    '.component-results'
                );

            container.innerHTML = '';

            const query =
                normalizeSearch(rawQuery);

            if (!query) {
                container.hidden = true;
                return;
            }


            const matches =
                existingEntries
                    .filter((entry) =>
                        getEntrySearchText(entry)
                            .includes(query)
                    )
                    .slice(0, 8);


            matches.forEach((entry) => {

                const button =
                    document.createElement(
                        'button'
                    );

                button.type = 'button';
                button.className =
                    'component-result';

                const head =
                    document.createElement(
                        'span'
                    );

                head.className =
                    'result-head';

                const headword =
                    document.createElement(
                        'span'
                    );

                headword.className =
                    'result-headword';

                headword.textContent =
                    entry.headword;

                const id =
                    document.createElement(
                        'span'
                    );

                id.className =
                    'result-id';

                id.textContent =
                    `ID: ${entry.id}`;

                head.append(
                    headword,
                    id
                );

                button.appendChild(head);


                if (
                    entry.definitions?.[0]
                ) {
                    const description =
                        document.createElement(
                            'span'
                        );

                    description.className =
                        'result-description';

                    description.textContent =
                        entry.definitions[0];

                    button.appendChild(
                        description
                    );
                }


                button.addEventListener(
                    'click',
                    () => {
                        selectExistingComponent(
                            item,
                            entry
                        );
                    }
                );

                container.appendChild(
                    button
                );

            });


            const pendingId =
                makeId(rawQuery);

            if (
                pendingId &&
                !existingIds.has(pendingId)
            ) {

                const pendingButton =
                    document.createElement(
                        'button'
                    );

                pendingButton.type =
                    'button';

                pendingButton.className =
                    'component-result pending-result';

                pendingButton.textContent =
                    `＋ 使用 "${pendingId}" ` +
                    `作为暂未收录的 ID`;

                pendingButton.addEventListener(
                    'click',
                    () => {
                        selectPendingComponent(
                            item,
                            rawQuery
                        );
                    }
                );

                container.appendChild(
                    pendingButton
                );

            }


            if (
                container.children.length === 0
            ) {
                container.hidden = true;
                return;
            }

            container.hidden = false;

        }


