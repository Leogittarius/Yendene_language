        function addSense(
            definition = '',
            gloss = ''
        ) {

            const item =
                document.createElement('div');

            item.className =
                'dynamic-item sense-item';

            /*
             * false：
             * Gloss 仍然由释义自动生成。
             *
             * true：
             * 用户已经手动修改 Gloss，
             * 此后不再自动覆盖。
             */
            item.dataset.glossManual =
                gloss ? 'true' : 'false';


            item.innerHTML = `
                <div class="dynamic-item-header">
                    <span class="dynamic-item-title"></span>

                    <button
                        type="button"
                        class="delete-button delete-sense"
                    >
                        删除
