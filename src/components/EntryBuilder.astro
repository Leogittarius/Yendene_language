        margin-top: 0.15rem;

        color: var(--sl-color-gray-3);

        font-size: 0.74rem;
    }

    .pending-result {
        color: var(--sl-color-accent-high);
    }

    .component-status {
        display: block;

        min-height: 1rem;

        margin-top: 0.35rem;

        color: var(--sl-color-gray-3);

        font-size: 0.74rem;
    }

    .component-status.valid {
        color: var(--sl-color-accent-high);
    }

    .component-status.warning {
        color: #b47b34;
