        /*
         * 创建一个 <option>。
         * 后面生成动词下拉框时重复使用。
         */
        function createOption(
            value,
            label
        ) {

            const option =
                document.createElement(
                    'option'
                );

            option.value =
                value;

            option.textContent =
                label;

            return option;

        }


        /*
         * 给一个动词成分创建 6 个特征槽位。
         *
         * 每个槽位：
         *
         * [范畴] [具体值]
         *
         * 例如：
         *
         * [时]   [将来]
         * [数]   [复数]
         * [体]   [完成]
         *
         * 六个槽位互相独立，
         * 空槽会被自动忽略。
         */
        function createVerbFeatureSlots(
            component
        ) {

            const container =
                component.querySelector(
                    '.verb-feature-slots'
                );


            /*
             * 防止重复生成。
             */
            container.innerHTML = '';


            for (
                let index = 0;
                index < 6;
                index += 1
            ) {

                const row =
                    document.createElement(
                        'div'
                    );

                row.className =
                    'verb-feature-row';


                /*
                 * 左边显示：
                 *
                 * 特征 1
                 * 特征 2
                 * ...
                 */
                const number =
                    document.createElement(
                        'span'
                    );

                number.className =
                    'feature-number';

                number.textContent =
                    `特征 ${index + 1}`;


                /*
                 * 第一列：
                 * 选择范畴。
                 */
                const kindSelect =
                    document.createElement(
                        'select'
                    );

                kindSelect.className =
                    'verb-feature-kind';


                kindSelect.appendChild(
                    createOption(
                        '',
                        '不选择'
                    )
                );


                Object.entries(
                    VERB_FEATURES
                ).forEach(
                    ([value, info]) => {

                        kindSelect.appendChild(
                            createOption(
                                value,
                                info.label
                            )
                        );

                    }
                );


                /*
                 * 第二列：
                 * 选择这个范畴的具体值。
                 *
                 * 没有选择范畴之前，
                 * 这里先禁用。
                 */
                const valueSelect =
                    document.createElement(
                        'select'
                    );

                valueSelect.className =
                    'verb-feature-value';

                valueSelect.disabled =
                    true;


                valueSelect.appendChild(
                    createOption(
                        '',
                        '—'
                    )
                );


                row.append(
                    number,
                    kindSelect,
                    valueSelect
                );


                container.appendChild(
                    row
                );

            }

        }


        /*
         * 用户选定一个动词范畴之后，
         * 根据范畴生成右边的可选值。
         *
         * 例如：
         *
         * 时
         * → 现在 / 过去 / 将来
         *
         * 语态
         * → 主动 / 被动 / 使动
         */
        function populateVerbFeatureValues(
            kindSelect
        ) {

            const row =
                kindSelect.closest(
                    '.verb-feature-row'
                );


            const valueSelect =
                row.querySelector(
                    '.verb-feature-value'
                );


            valueSelect.innerHTML =
                '';


            const kind =
                kindSelect.value;


            /*
             * 范畴为空：
             * 右边也清空并禁用。
             */
            if (!kind) {

                valueSelect.disabled =
                    true;


                valueSelect.appendChild(
                    createOption(
                        '',
                        '—'
                    )
                );


                return;

            }


            valueSelect.disabled =
                false;


            valueSelect.appendChild(
                createOption(
                    '',
                    '不选择'
                )
            );


            const feature =
                VERB_FEATURES[kind];


            feature.values.forEach(
                (valueInfo) => {

                    const option =
                        createOption(
                            valueInfo.value,
                            valueInfo.label
                        );


                    /*
                     * 真正生成 Gloss 时，
                     * 使用 data-gloss。
                     *
                     * 比如：
                     *
                     * UI 显示：将来
                     * Gloss 使用：将来时
                     */
                    option.dataset.gloss =
                        valueInfo.gloss;


                    valueSelect.appendChild(
                        option
                    );

                }
            );

        }



        /*
         * 给义项选择框填内容。
         *
         * 如果一个词只有一个义项，
         * 就只有一个选项。
         *
         * 如果有多个义项，
         * 用户可以明确选择该例句使用哪个。
         */
        function populateExampleSenseSelect(
            component,
            entry
        ) {

            const select =
                component.querySelector(
                    '.example-sense'
                );


            select.innerHTML = '';


            const senses =
                entry.senses ?? [];


            if (senses.length === 0) {

                const option =
                    document.createElement(
                        'option'
                    );

                option.value = '0';
                option.textContent =
                    '没有可用义项';

                select.appendChild(
                    option
                );

                select.disabled =
                    true;

                return;

            }


            select.disabled =
                false;


            senses.forEach(
                (sense, index) => {

                    const option =
                        document.createElement(
                            'option'
                        );

                    option.value =
                        String(index);


                    const text =
                        sense.definition ||
                        sense.gloss ||
                        `义项 ${index + 1}`;


                    option.textContent =
                        `${index + 1}. ${text}`;


                    select.appendChild(
                        option
                    );

                }
            );

        }


        function setExampleWordStatus(
            component,
            message,
            state = ''
        ) {

            const statusElement =
                component.querySelector(
                    '.example-word-status'
                );


            statusElement.className =
                `example-word-status ${state}`;


            statusElement.textContent =
                message;

        }


        /*
         * 用户点击某个搜索结果之后，
         * 真正选中这个词条。
         */
        function selectExampleEntry(
            component,
            entry
        ) {

            /*
             * 保存真正的稳定 ID。
             */
            component.dataset.ref =
                entry.id;


            /*
             * 标记它是不是当前正在创建的新词。
             */
            component.dataset.current =
                entry.isCurrent
                    ? 'true'
                    : 'false';


            const searchInput =
                component.querySelector(
                    '.example-search'
                );

            const surfaceInput =
                component.querySelector(
                    '.example-surface'
                );


            /*
             * 搜索框显示 headword，
             * 但程序内部保存的是 ID。
             */
            searchInput.value =
                entry.headword;


            /*
             * 默认给出句中形式。
             *
             * nu(-e) 会自动成为 nu。
             *
             * 用户之后仍然可以手动改成
             * 真正的变格 / 变位形式。
             */
            surfaceInput.value =
                makeSurfaceFromHeadword(
                    entry.headword
                );


            populateExampleSenseSelect(
                component,
                entry
            );


            setExampleWordStatus(
                component,

                entry.isCurrent
                    ? `✓ 当前词条 · ID: ${entry.id}`
                    : `✓ 已选择 ID: ${entry.id}`,

                'valid'
            );


            component.querySelector(
                '.example-search-results'
            ).hidden = true;


            update();

        }


        /*
         * 根据搜索框内容显示候选词。
         */
        function renderExampleSearchResults(
            component,
            rawQuery
        ) {

            const resultBox =
                component.querySelector(
                    '.example-search-results'
                );


            resultBox.innerHTML = '';


            const query =
                normalizeSearch(
                    rawQuery
                );


            if (!query) {

                resultBox.hidden =
                    true;

                return;

            }


            const matches =
                getExampleSearchPool()

                    .filter(
                        (entry) =>
                            getEntrySearchText(
                                entry
                            ).includes(query)
                    )

                    .slice(0, 8);


            matches.forEach(
                (entry) => {

                    const button =
                        document.createElement(
                            'button'
                        );


                    button.type =
                        'button';

                    button.className =
                        'example-search-result';


                    const title =
                        document.createElement(
                            'span'
                        );

                    title.style.fontWeight =
                        '650';

                    title.textContent =
                        entry.headword;


                    const id =
                        document.createElement(
                            'span'
                        );

                    id.style.marginLeft =
                        '0.5rem';

                    id.style.opacity =
                        '0.65';

                    id.style.fontSize =
                        '0.74rem';


                    id.textContent =
                        entry.isCurrent
                            ? `当前词条 · ${entry.id}`
                            : `ID: ${entry.id}`;


                    button.append(
                        title,
                        id
                    );


                    if (
                        entry.definitions?.[0]
                    ) {

                        const description =
                            document.createElement(
                                'span'
                            );

                        description.style.display =
                            'block';

                        description.style.marginTop =
                            '0.15rem';

                        description.style.opacity =
                            '0.7';

                        description.style.fontSize =
                            '0.74rem';

                        description.textContent =
                            entry.definitions[0];


                        button.appendChild(
                            description
                        );

                    }


                    button.addEventListener(
                        'click',
                        () => {

                            selectExampleEntry(
                                component,
                                entry
                            );

                        }
                    );


                    resultBox.appendChild(
                        button
                    );

                }
            );


            resultBox.hidden =
                resultBox.children.length === 0;

        }


        /*
         * 根据一个成分保存的 ID，
         * 找回完整词条。
         */
        function getSelectedExampleEntry(
            component
        ) {

            if (
                component.dataset.current ===
                'true'
            ) {

                return getCurrentLookupEntry();

            }


            const ref =
                component.dataset.ref;


            if (!ref) {
                return null;
            }


            return existingEntries.find(
                (entry) =>
                    entry.id === ref
            ) ?? null;

        }


        /*
         * 得到这个成分的纯词汇 Gloss。
         *
         * 现在还不添加：
         * 格、数、时、体等语法信息。
         */
        function getExampleLexicalGloss(
            component
        ) {

            const entry =
                getSelectedExampleEntry(
                    component
                );


            if (!entry) {
                return '?';
            }


            const senseSelect =
                component.querySelector(
                    '.example-sense'
                );


            const senseIndex =
                Number(
                    senseSelect.value || 0
                );


            const sense =
                entry.senses?.[senseIndex] ??
                entry.senses?.[0];


            if (!sense) {
                return '?';
            }


            if (
                sense.gloss?.trim()
            ) {

                return sense.gloss.trim();

            }


            return (
                makeGlossFromDefinition(
                    sense.definition
                ) || '?'
            );

        }





        /*
         * 读取变格成分的语法信息。
         *
         * 例如：
         *
         * 数 = 复数
         * 格 = 方位
         *
         * →
         *
         * ["复数", "方位"]
         */
        function getNominalFeatureGlosses(
            component
        ) {

            const result = [];


            const number =
                component.querySelector(
                    '.nominal-number'
                ).value;


            const grammaticalCase =
                component.querySelector(
                    '.nominal-case'
                ).value;


            if (number) {

                result.push(
                    number
                );

            }


            if (grammaticalCase) {

                result.push(
                    grammaticalCase
                );

            }


            return result;

        }


        /*
         * 读取动词的 6 个特征槽位。
         *
         * 空槽自动忽略。
         */
        function getVerbFeatureGlosses(
            component
        ) {

            const result = [];


            const rows =
                component.querySelectorAll(
                    '.verb-feature-row'
                );


            rows.forEach(
                (row) => {

                    const kind =
                        row.querySelector(
                            '.verb-feature-kind'
                        ).value;


                    const valueSelect =
                        row.querySelector(
                            '.verb-feature-value'
                        );


                    const value =
                        valueSelect.value;


                    /*
                     * 范畴或者值有一个没选，
                     * 就直接忽略这个槽位。
                     */
                    if (
                        !kind ||
                        !value
                    ) {
                        return;
                    }


                    const option =
                        valueSelect
                            .selectedOptions[0];


                    const gloss =
                        option?.dataset.gloss;


                    if (gloss) {

                        result.push(
                            gloss
                        );

                    }

                }
            );


            return result;

        }






        /*
         * 生成一个完整成分的 Gloss。
         *
         * 第一步：
         * 从词典得到 lexical gloss。
         *
         * 第二步：
         * 根据成分类型追加语法特征。
         */
        function getMorphFeatureGlosses(
            component
        ) {

            const value =
                component.querySelector(
                    '.morph-feature'
                ).value;


            if (!value) {
                return [];
            }


            return [
                value
            ];

        }
        function buildExampleComponentGloss(
            component
        ) {

            const lexicalGloss =
                getExampleLexicalGloss(
                    component
                );


            const type =
                component.querySelector(
                    '.example-component-type'
                ).value;


            let features = [];


            if (type === 'nominal') {

                features =
                    getNominalFeatureGlosses(
                        component
                    );

            }


            if (type === 'verb') {

                features =
                    getVerbFeatureGlosses(
                        component
                    );

            }


            if (type === 'morph') {

                features =
                    getMorphFeatureGlosses(
                        component
                    );

            }

            return [
                lexicalGloss,
                ...features,
            ]
                .filter(Boolean)
                .join('-');

        }

        /*
         * 刷新一个例句最下面的
         * 自动原文和自动 Gloss。
         */
        function refreshExamplePreview(
            example
        ) {

            const components =
                Array.from(
                    example.querySelectorAll(
                        '.example-component'
                    )
                );


            const sourceParts = [];
            const glossParts = [];


            components.forEach(
                (component) => {

                    const surface =
                        component.querySelector(
                            '.example-surface'
                        ).value.trim();


                    const ref =
                        component.dataset.ref;


                    /*
                    * 完全空白的成分直接忽略。
                    */
                    if (
                        !surface &&
                        !ref
                    ) {
                        return;
                    }


                    sourceParts.push(
                        surface || '?'
                    );


                    glossParts.push(
                        buildExampleComponentGloss(
                            component
                        )
                    );

                }
            );


            /*
            * 原文始终由各成分自动生成。
            */
            example.querySelector(
                '.example-source-preview'
            ).value =
                sourceParts.join(
                    ' | '
                );


            /*
            * Gloss 默认自动生成。
            *
            * 但是一旦用户手动修改过 Gloss，
            * 就不再覆盖用户的版本。
            */
            if (
                example.dataset.glossManual !==
                'true'
            ) {

                example.querySelector(
                    '.example-gloss-preview'
                ).value =
                    glossParts.join(
                        ' | '
                    );

            }

        }


        function refreshAllExamplePreviews() {

            exampleList
