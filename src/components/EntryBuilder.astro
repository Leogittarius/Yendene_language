        </section>

    </div>


        <!-- =====================================
            Output
            ===================================== -->

        <aside class="builder-output">

            <div class="output-header">

                <div>
                    <h2>生成结果</h2>

                    <p>
                        生成单个词条对象，可直接加入
                        dictionary.json 的 entries 数组。
                    </p>
                </div>

                <button
                    id="eb-copy"
                    class="copy-button"
                    type="button"
                    disabled
                >
                    复制 JSON
                </button>

            </div>

            <div
                id="eb-validation"
                class="validation"
            ></div>

            <textarea
                id="eb-output"
                class="json-output"
                readonly
                spellcheck="false"
            ></textarea>

        </aside>

    </div>


<script
    id="eb-existing-entries"
    type="application/json"
    set:html={lookupJson}
></script>


