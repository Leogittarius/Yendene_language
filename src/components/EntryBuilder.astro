    .builder-section,
    :root[data-theme='light']
    .builder-output {
        background: #f8fbfc;
        border-color: #d6e2e8;
    }

    :root[data-theme='dark']
    .builder-section,
    :root[data-theme='dark']
    .builder-output {
        background: #101f27;
        border-color: #273c47;
    }

    .builder-section h2,
    .builder-output h2 {
        margin: 0 !important;

        font-size: 1.05rem;
        letter-spacing: -0.01em;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;

        gap: 1rem;

        margin:
            0
            0
            1rem !important;
    }


    /* Fields */

    .field {
        display: block;

        margin:
            0
            0
            1rem !important;
    }

    .field:last-child {
        margin-bottom: 0 !important;
    }

    .field-label {
        display: block;

        margin-bottom: 0.4rem;

        color: var(--sl-color-gray-1);

        font-size: 0.84rem;
        font-weight: 650;
    }

    .field-help {
        display: block;

        margin-top: 0.35rem;

        color: var(--sl-color-gray-3);

        font-size: 0.76rem;
        line-height: 1.5;
    }

    input[type='text'],
    textarea,
    select {
        display: block;

        box-sizing: border-box;

        width: 100%;

        margin: 0 !important;
        padding: 0.62rem 0.72rem;

        border:
            1px solid
            var(--sl-color-hairline);

        border-radius: 0.42rem;

        background: var(--sl-color-bg);

        color: var(--sl-color-white);

        font: inherit;
        font-size: 0.9rem;

        outline: none;
    }

    textarea {
        resize: vertical;
    }

    input[type='text']:focus,
    textarea:focus,
    select:focus {
        border-color:
            var(--sl-color-accent);
    }


    /* ID */

    .id-row {
        display: grid;
        grid-template-columns:
            minmax(0, 1fr)
            auto;

        gap: 0.5rem;
    }

    #eb-id-message.warning {
        color: #b47b34;
    }

    #eb-id-message.valid {
        color: var(--sl-color-accent-high);
    }


    /* POS */

    .checkbox-grid {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 0.4rem;
    }

    .checkbox-grid label {
        display: flex;
        align-items: center;

        gap: 0.45rem;

        margin: 0 !important;
        padding: 0.45rem 0.55rem;

        border:
            1px solid
            var(--sl-color-hairline);

        border-radius: 0.38rem;

        color: var(--sl-color-gray-2);

        font-size: 0.78rem;
    }

    .checkbox-grid input {
        margin: 0 !important;
    }


    /* Dynamic items */

    .dynamic-item {
        padding: 0.9rem;

        border:
            1px solid
            var(--sl-color-hairline);

        border-radius: 0.45rem;

        margin:
            0
            0
            0.7rem !important;
    }

    .dynamic-item:last-child {
