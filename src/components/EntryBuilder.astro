</style>


<script>

    function initialiseEntryBuilder() {

        const root =
            document.querySelector('.entry-builder');

        if (!root) return;


        const headword =
            root.querySelector('#eb-headword');

        const idInput =
            root.querySelector('#eb-id');

        const regenerateId =
            root.querySelector('#eb-regenerate-id');

        const type =
            root.querySelector('#eb-type');

        const status =
            root.querySelector('#eb-status');

        const definition =
            root.querySelector('#eb-definition');

        const gloss =
            root.querySelector('#eb-gloss');

        const formationType =
            root.querySelector(
                '#eb-formation-type'
            );

        const analysis =
            root.querySelector('#eb-analysis');

        const ipa =
            root.querySelector('#eb-ipa');

        const etymology =
            root.querySelector('#eb-etymology');

        const notes =
            root.querySelector('#eb-notes');

        const output =
            root.querySelector('#eb-output');

        const validation =
            root.querySelector('#eb-validation');

        const copyButton =
            root.querySelector('#eb-copy');


        let idEditedManually = false;


        function makeId(value) {

            return value

                /* 删除括号及括号中的内容 */
                .replace(/\([^)]*\)/g, '')

                /* 拆分附加符号 */
                .normalize('NFD')

                /* 删除音调 / 长音等组合符号 */
                .replace(
                    /[\u0300-\u036f]/g,
                    ''
                )

                .toLowerCase()

                .trim()

                /* 空白变短杠 */
                .replace(/\s+/g, '-')

                /* 删除不允许的字符 */
                .replace(/[^a-z0-9-]/g, '')

                /* 多个短杠合一 */
                .replace(/-{2,}/g, '-');
        }


        function getSelectedPos() {

            return Array.from(
                root.querySelectorAll(
                    'input[name="pos"]:checked'
                )
            ).map(
                (checkbox) =>
                    checkbox.value
            );

        }


        function buildEntry() {

            const selectedPos =
                getSelectedPos();

            const sense = {
                definition:
                    definition.value.trim(),

                gloss:
                    gloss.value.trim()
            };


            return {
                id:
                    idInput.value.trim(),

                headword:
                    headword.value.trim(),

                type:
                    type.value,

                pos:
                    selectedPos,

                pronunciation: {
                    ipa:
                        ipa.value.trim()
                },

                senses: [
                    sense
                ],

                formation: {
                    type:
                        formationType.value,

                    analysis:
                        analysis.value.trim(),

                    components: []
                },

                etymology:
                    etymology.value.trim(),

                variants: [],

                relations: {
                    related: [],
                    synonyms: [],
                    antonyms: [],
                    derived: []
                },

                examples: [],

                status:
                    status.value,

                tags: [],

                notes:
                    notes.value.trim()
            };

        }


        function validateEntry(entry) {

            const errors = [];


            if (!entry.headword) {
                errors.push('请填写词头。');
            }

            if (!entry.id) {
                errors.push('ID 不能为空。');
            }

            if (
                entry.id &&
                !/^[a-z0-9-]+$/.test(entry.id)
            ) {
                errors.push(
                    'ID 只能包含小写 ASCII 字母、数字和短杠。'
                );
            }

            if (
                entry.type !== 'root' &&
                entry.pos.length === 0
            ) {
                errors.push(
                    '请选择至少一个词性。'
                );
            }

            if (
                !entry.senses[0].definition
            ) {
                errors.push('请填写释义。');
            }


            return errors;

        }


        function update() {

            const entry =
                buildEntry();

            const errors =
                validateEntry(entry);


            output.value =
                JSON.stringify(
                    entry,
                    null,
                    2
                );


            if (errors.length > 0) {

                validation.className =
                    'validation error';

                validation.textContent =
                    errors.join(' ');

                copyButton.disabled = true;

                return;

            }


            validation.className =
                'validation valid';

            validation.textContent =
                '✓ 当前基本字段有效';

            copyButton.disabled = false;

        }


        headword.addEventListener(
            'input',
            () => {

                if (!idEditedManually) {
                    idInput.value =
                        makeId(headword.value);
                }

                update();

            }
        );


        idInput.addEventListener(
            'input',
            () => {

                idEditedManually = true;

                update();

            }
        );


        regenerateId.addEventListener(
            'click',
            () => {

                idEditedManually = false;

                idInput.value =
                    makeId(headword.value);

                update();

            }
        );


        root
            .querySelectorAll(
                'input, textarea, select'
            )
            .forEach((element) => {

                if (
                    element === headword ||
                    element === idInput
                ) {
                    return;
                }

                element.addEventListener(
                    'input',
                    update
                );

                element.addEventListener(
                    'change',
                    update
                );

            });


        copyButton.addEventListener(
            'click',
            async () => {

                if (copyButton.disabled) {
                    return;
                }

                try {

                    await navigator.clipboard
                        .writeText(
                            output.value
                        );

                    const oldText =
                        copyButton.textContent;

                    copyButton.textContent =
                        '已复制';

                    window.setTimeout(
                        () => {
                            copyButton.textContent =
                                oldText;
                        },
                        1200
                    );

                }
                catch {

                    validation.className =
                        'validation error';

                    validation.textContent =
                        '复制失败，请手动复制 JSON。';

                }

            }
        );


        update();

    }


    initialiseEntryBuilder();

</script>