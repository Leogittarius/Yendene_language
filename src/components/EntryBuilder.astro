        /*
         * 监听整个义项区域。
         *
         * 修改释义：
         * 自动更新 Gloss。
         *
         * 用户亲自修改 Gloss：
         * 停止自动覆盖该义项的 Gloss。
         */
        senseList.addEventListener(
            'input',
            (event) => {

                const item =
                    event.target.closest(
                        '.sense-item'
                    );

                if (!item) return;


                const definitionInput =
                    item.querySelector(
                        '.sense-definition'
                    );

                const glossInput =
                    item.querySelector(
                        '.sense-gloss'
                    );


                if (
                    event.target ===
                        definitionInput &&
                    item.dataset.glossManual !==
                        'true'
                ) {

                    glossInput.value =
                        makeGlossFromDefinition(
                            definitionInput.value
                        );

                }


                if (
                    event.target ===
                        glossInput
                ) {

                    item.dataset.glossManual =
                        'true';

                }


                update();

            }
        );



