        /*
         * 从词典显示形式得到一个默认的句中形式。
         *
         * 例如：
         * nu(-e) → nu
         */
        function makeSurfaceFromHeadword(value) {

            return String(value)
                .replace(/\([^)]*\)/g, '')
                .trim();

        }


        /*
         * 正在填写的新词条本身还没有进入
         * dictionary.json。
         *
         * 但我们仍然希望给它写例句时，
         * 能在例句搜索里找到它自己。
         */
        function getCurrentLookupEntry() {

            const currentHeadword =
                headword.value.trim();

            const currentId =
                idInput.value.trim();


            if (
                !currentHeadword &&
                !currentId
            ) {
                return null;
            }


            const senses =
                getSenses();


            return {

                id:
                    currentId || '__current__',

                headword:
                    currentHeadword ||
                    currentId,

                pos:
                    getSelectedPos(),

                senses,

                definitions:
                    senses
                        .map(
                            (sense) =>
                                sense.definition
                        )
                        .filter(Boolean),

                glosses:
                    senses
                        .map(
                            (sense) =>
                                sense.gloss ||
                                makeGlossFromDefinition(
                                    sense.definition
                                )
                        )
                        .filter(Boolean),

                variants: [],

                isCurrent: true,

            };

        }


        /*
         * 例句搜索使用：
         *
         * 1. 当前正在填写的新词
         * 2. 已经存在于 dictionary.json 的词
         */
        function getExampleSearchPool() {

            const current =
                getCurrentLookupEntry();


            if (!current) {
                return existingEntries;
            }


            return [
                current,
                ...existingEntries,
            ];

        }


