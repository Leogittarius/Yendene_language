<script>

    function makeGlossFromDefinition(value) {

        return String(value)
            .split(/[，,、；;\/／]/)
            .map((part) => part.trim())
            .find(Boolean) ?? '';

    }

    function initialiseEntryBuilder() {

        const root =
            document.querySelector('.entry-builder');

        if (!root) return;


        /* =====================================
           Existing dictionary
           ===================================== */

        const dataScript =
            document.querySelector(
                '#eb-existing-entries'
            );

        const existingEntries =
            JSON.parse(
                dataScript?.textContent ?? '[]'
            );

        const existingIds =
            new Set(
                existingEntries.map(
                    (entry) => entry.id
                )
            );
        const CASE_OPTIONS = [
            '施事',
