        gap: 0.65rem;
    }

    .sense-fields .field {
        margin-bottom: 0 !important;
    }


    /* Components */

    .component-block {
        margin-top: 1.2rem;
    }

    .component-header {
        margin-bottom: 0.7rem !important;
    }

    .component-fields {
        display: grid;
        grid-template-columns:
            minmax(0, 1fr)
            minmax(9rem, 0.6fr);

        gap: 0.65rem;
