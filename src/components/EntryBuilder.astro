         /*
         * 把页面中的全部例句整理成
         * dictionary.json 所需要的格式。
         */
        function getExamples() {

            return Array.from(
                exampleList.querySelectorAll(
                    '.example-item'
                )
            )

            .map(
                (example) => {

                    const source =
                        example.querySelector(
                            '.example-source-preview'
                        ).value.trim();


                    const gloss =
                        example.querySelector(
                            '.example-gloss-preview'
                        ).value.trim();


                    const translation =
                        example.querySelector(
                            '.example-translation'
                        ).value.trim();


                    /*
                     * 一个完全没有填写内容的例句
                     * 不写进 JSON。
                     */
                    const hasComponents =
                        example.querySelectorAll(
                            '.example-component'
                        ).length > 0;


                    if (
                        !source &&
                        !gloss &&
                        !translation &&
                        !hasComponents
                    ) {

                        return null;

                    }


                    const result = {

                        source,
                        gloss,

                    };


                    /*
                     * translation 是可选字段。
                     *
                     * 这样例词可以只保存：
                     *
                     * source + gloss
                     */
                    if (translation) {

                        result.translation =
                            translation;

                    }


                    return result;

                }
            )

            .filter(Boolean);

        }

