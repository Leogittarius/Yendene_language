            return Array.from(
                senseList.querySelectorAll(
                    '.sense-item'
                )
            )
            .map((item) => {

                const definition =
                    item.querySelector(
                        '.sense-definition'
                    ).value.trim();

                const gloss =
                    item.querySelector(
                        '.sense-gloss'
                    ).value.trim();


                if (
                    !definition &&
                    !gloss
                ) {
                    return null;
                }


                const sense = {
                    definition
                };

                if (gloss) {
                    sense.gloss =
                        gloss;
                }

                return sense;

            })
            .filter(Boolean);

        }


        function getComponents() {

            if (
                formationType.value ===
                    'simple' ||
                formationType.value ===
                    'root'
            ) {
                return [];
            }


            return Array.from(
                componentList.querySelectorAll(
                    '.component-item'
                )
            )
            .map((item) => {

                const ref =
                    item.dataset.ref ?? '';

                const form =
                    item.querySelector(
                        '.component-form'
                    ).value.trim();

                const search =
                    item.querySelector(
                        '.component-search'
                    ).value.trim();


                if (
                    !ref &&
                    !form &&
                    !search
                ) {
                    return null;
                }


                return {
                    ref,
                    form
                };

            })
            .filter(Boolean);

        }


        function buildEntry() {

            return {
                id:
                    idInput.value.trim(),

                headword:
                    headword.value.trim(),

                type:
                    type.value,

                pos:
                    getSelectedPos(),

                pronunciation: {
                    ipa:
                        ipa.value.trim()
                },

                senses:
                    getSenses(),

                formation: {
                    type:
                        formationType.value,

                    analysis:
                        analysis.value.trim(),

                    components:
                        getComponents()
                },

                etymology:
                    etymology.value.trim(),

                variants: [],

                relations: {
                    related: [],
                    synonyms: [],
                    antonyms: [],
                    derived: []
                },

                examples: getExamples(),

                status:
                    status.value,

                tags: [],

                notes:
                    notes.value.trim()
            };

        }


        /* =====================================
           Validation
           ===================================== */

        function validateEntry(entry) {

            const errors = [];


            if (!entry.headword) {
                errors.push(
                    '请填写词头。'
                );
            }


            if (!entry.id) {
                errors.push(
                    'ID 不能为空。'
                );
            }
            else if (
                !/^[a-z0-9-]+$/.test(
                    entry.id
                )
            ) {
                errors.push(
                    'ID 只能包含小写 ASCII 字母、数字和短杠。'
                );
            }
            else if (
                existingIds.has(
                    entry.id
                )
            ) {
                errors.push(
                    `ID "${entry.id}" 已存在。`
                );
            }


            if (
                entry.type !== 'root' &&
                entry.pos.length === 0
            ) {
                errors.push(
                    '请选择至少一个词性。'
                );
            }


            if (
                entry.senses.length === 0
            ) {
                errors.push(
                    '至少需要一个义项。'
                );
            }

            entry.senses.forEach(
                (sense, index) => {

                    if (!sense.definition) {
                        errors.push(
                            `义项 ${index + 1} ` +
                            `缺少释义。`
                        );
                    }

                }
            );


            entry.formation.components
                .forEach(
                    (component, index) => {

                        if (!component.ref) {
                            errors.push(
                                `构词成分 ` +
                                `${index + 1} ` +
                                `尚未选择 ref。`
                            );
                        }

                        if (!component.form) {
                            errors.push(
                                `构词成分 ` +
                                `${index + 1} ` +
                                `缺少实际形式。`
                            );
                        }

                    }
                );

             /*
             * Examples
             */
            entry.examples.forEach(
                (example, index) => {

                    if (!example.source) {

                        errors.push(
                            `例句 ${index + 1} ` +
                            `缺少原文。`
                        );

                    }


                    if (!example.gloss) {

                        errors.push(
                            `例句 ${index + 1} ` +
                            `缺少 Gloss。`
                        );

                    }


                    /*
                     * 有原文和 Gloss 时，
                     * 检查 "|" 分组数量是否一致。
                     */
                    if (
                        example.source &&
                        example.gloss
                    ) {

                        const sourceParts =
                            example.source
                                .split('|')
                                .map(
                                    (part) =>
                                        part.trim()
                                );


                        const glossParts =
                            example.gloss
                                .split('|')
                                .map(
                                    (part) =>
                                        part.trim()
                                );


                        if (
                            sourceParts.length !==
                            glossParts.length
                        ) {

                            errors.push(
                                `例句 ${index + 1}：` +
                                `原文有 ` +
                                `${sourceParts.length} 个成分，` +
                                `Gloss 有 ` +
                                `${glossParts.length} 个成分。`
                            );

                        }

                    }

                }
            );


            return errors;

        }


        function update() {

            refreshAllExamplePreviews();

            const entry =
                buildEntry();

            const errors =
                validateEntry(entry);


            output.value =
                JSON.stringify(
                    entry,
                    null,
                    2
                );


            if (errors.length > 0) {

                validation.className =
                    'validation error';

                validation.textContent =
                    errors.join(' ');

                copyButton.disabled =
                    true;

                return;

            }


            validation.className =
                'validation valid';

            validation.textContent =
                '✓ 当前词条基本结构有效';

            copyButton.disabled =
                false;

        }


        /* =====================================
           Events
           ===================================== */

        headword.addEventListener(
            'input',
            () => {

                if (!idEditedManually) {
                    updateAutomaticId();
                }

                update();

            }
        );


        idInput.addEventListener(
            'input',
            () => {

                idEditedManually =
                    true;

                updateManualIdMessage();
                update();

            }
        );


        regenerateId.addEventListener(
            'click',
            () => {

                idEditedManually =
                    false;

                updateAutomaticId();
                update();

            }
        );


        addSenseButton.addEventListener(
            'click',
            () => {
                addSense();
            }
        );


        addComponentButton.addEventListener(
            'click',
            () => {
                addComponent();
            }
        );


        senseList.addEventListener(
            'click',
            (event) => {

                const button =
                    event.target.closest(
                        '.delete-sense'
                    );

                if (!button) return;

                const item =
                    button.closest(
                        '.sense-item'
                    );

                if (!item) return;

                item.remove();

                refreshSenseNumbers();
                update();

            }
        );


        componentList.addEventListener(
            'click',
            (event) => {

                const button =
                    event.target.closest(
                        '.delete-component'
                    );

                if (!button) return;

                const item =
                    button.closest(
                        '.component-item'
                    );

                if (!item) return;

                item.remove();

                update();

            }
        );


        componentList.addEventListener(
            'input',
            (event) => {

                const search =
                    event.target.closest(
                        '.component-search'
                    );

                if (search) {

                    const item =
                        search.closest(
                            '.component-item'
                        );

                    item.dataset.ref = '';

                    setComponentStatus(
                        item,
                        '尚未选择引用。'
                    );

                    renderComponentResults(
                        item,
                        search.value
                    );

                }

                update();

            }
        );


        root.addEventListener(
            'input',
            (event) => {

                if (
                    event.target ===
                        headword ||
                    event.target ===
                        idInput ||
                    event.target.closest(
                        '.component-search'
                    )
                ) {
                    return;
                }

                update();

            }
        );


        root.addEventListener(
            'change',
            (event) => {

                if (
                    event.target ===
                    formationType
                ) {
                    updateComponentVisibility();
                }

                update();

            }
        );


        document.addEventListener(
            'click',
            (event) => {

                if (
                    event.target.closest(
                        '.component-picker'
                    )
                ) {
                    return;
                }

                root
                    .querySelectorAll(
                        '.component-results'
                    )
                    .forEach(
                        (results) => {
                            results.hidden =
                                true;
                        }
                    );

            }
        );


        copyButton.addEventListener(
            'click',
            async () => {

                if (copyButton.disabled) {
                    return;
                }

                try {

                    await navigator.clipboard
                        .writeText(
                            output.value
                        );

                    const oldText =
                        copyButton.textContent;

                    copyButton.textContent =
                        '已复制';

                    window.setTimeout(
                        () => {
                            copyButton.textContent =
                                oldText;
                        },
                        1200
                    );

                }
                catch {

                    validation.className =
                        'validation error';

                    validation.textContent =
                        '复制失败，请手动复制 JSON。';

                }

            }
        );


        /* =====================================
           Initialise
           ===================================== */

        addSense();

        updateComponentVisibility();
        updateAutomaticId();
        update();

    }


    initialiseEntryBuilder();

</script>