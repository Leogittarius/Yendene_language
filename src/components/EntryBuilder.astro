        color: var(--sl-color-gray-3);

        font-size: 0.78rem;
    }

    .validation.error {
        color: #c66;
    }

    .validation.valid {
        color: var(--sl-color-accent-high);
    }

    .json-output {
        min-height: 38rem;

        font-family:
            ui-monospace,
            SFMono-Regular,
            Consolas,
            monospace;

        font-size: 0.8rem;
        line-height: 1.55;
