---
import dictionary from '@data/dictionary.json';

const lookupEntries = dictionary.entries.map((entry) => ({
    id: entry.id,
    headword: entry.headword,
    pos: entry.pos ?? [],
    definitions: (entry.senses ?? [])
        .map((sense) => sense.definition)
        .filter(Boolean),
    glosses: (entry.senses ?? [])
        .map((sense) => sense.gloss)
        .filter(Boolean),
}));
---

<div class="entry-builder">

    <div class="builder-form">

        <!-- =====================================
             Basic information
             ===================================== -->

        <section class="builder-section">
            <h2>基本信息</h2>

            <label class="field">
                <span class="field-label">词头</span>

                <input
                    id="eb-headword"
                    type="text"
                    placeholder="例如：nu(-e)"
                />
            </label>


            <div class="field">
                <span class="field-label">ID</span>

                <div class="id-row">
                    <input
                        id="eb-id"
                        type="text"
                        placeholder="自动生成"
                    />

                    <button
                        id="eb-regenerate-id"
                        class="small-button"
                        type="button"
                    >
                        重新生成
                    </button>
                </div>

                <span
                    id="eb-id-message"
                    class="field-help"
                >
                    根据词头自动建议，可手动修改。
                </span>
            </div>


            <label class="field">
                <span class="field-label">条目类型</span>

                <select id="eb-type">
                    <option value="word">
                        word — 词
                    </option>

                    <option value="affix">
                        affix — 词缀
                    </option>

                    <option value="root">
                        root — 词根
                    </option>

                    <option value="clitic">
                        clitic — 附着词
                    </option>

                    <option value="phrase">
                        phrase — 短语
                    </option>
                </select>
            </label>


            <div class="field">
                <span class="field-label">词性</span>

                <div class="checkbox-grid">

                    <label>
                        <input type="checkbox" name="pos" value="noun" />
                        <span>n. 普通名词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="verb" />
                        <span>v. 普通动态动词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="stative" />
                        <span>stat. 状态动词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="numeral" />
                        <span>num. 数量状态动词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="pronoun" />
                        <span>pron. 代词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="function" />
                        <span>func. 普通功能词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="lightverb" />
                        <span>lv. 轻动词</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="particle" />
                        <span>part. 构式粒子</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="affix" />
                        <span>aff. 普通派生词缀</span>
                    </label>

                    <label>
                        <input type="checkbox" name="pos" value="converb" />
                        <span>conv. 副动词后缀</span>
                    </label>

                </div>
            </div>


            <label class="field">
                <span class="field-label">状态</span>

                <select id="eb-status">
                    <option value="established">
                        established — 已确定
                    </option>

                    <option value="draft">
                        draft — 草案
                    </option>

                    <option value="deprecated">
                        deprecated — 已废弃
                    </option>
                </select>
            </label>
        </section>


        <!-- =====================================
             Senses
             ===================================== -->

        <section class="builder-section">
            <div class="section-header">
                <h2>义项</h2>

                <button
                    id="eb-add-sense"
                    class="small-button"
                    type="button"
                >
                    ＋ 添加义项
                </button>
            </div>

            <div id="eb-sense-list"></div>
        </section>


        <!-- =====================================
             Formation
             ===================================== -->

        <section class="builder-section">
            <h2>构词</h2>

            <label class="field">
                <span class="field-label">构词类型</span>

                <select id="eb-formation-type">
                    <option value="simple">
                        simple — 单纯形式
                    </option>

                    <option value="root">
                        root — 词根
                    </option>

                    <option value="derived">
                        derived — 派生
                    </option>

                    <option value="compound">
                        compound — 复合
                    </option>

                    <option value="reduplicated">
                        reduplicated — 重叠
                    </option>

                    <option value="ideophonic">
                        ideophonic — 拟声 / 表意
                    </option>

                    <option value="opaque">
                        opaque — 构词不透明
                    </option>

                    <option value="borrowed">
                        borrowed — 借词
                    </option>
                </select>
            </label>


            <label class="field">
                <span class="field-label">构词分析</span>

                <input
                    id="eb-analysis"
                    type="text"
                    placeholder="例如：ma-talge"
                />

                <span class="field-help">
                    analysis 只是显示用字符串，不参与词条引用。
                </span>
            </label>


            <div
                id="eb-component-block"
                class="component-block"
            >
                <div class="section-header component-header">
                    <div>
                        <span class="field-label">
                            构词成分
                        </span>

                        <span class="field-help">
                            ref 默认使用词条的 ID，而不是显示词形。
                            可以搜索现有词条，也可以建立暂未收录的 ID。
                        </span>
                    </div>

                    <button
                        id="eb-add-component"
                        class="small-button"
                        type="button"
                    >
                        ＋ 添加成分
                    </button>
                </div>

                <div id="eb-component-list"></div>
            </div>
        </section>


        <!-- =====================================
             Other
             ===================================== -->

        <section class="builder-section">
            <h2>其他</h2>

            <label class="field">
                <span class="field-label">IPA</span>

                <input
                    id="eb-ipa"
                    type="text"
                    placeholder="可留空"
                />
            </label>

            <label class="field">
                <span class="field-label">词源</span>

                <textarea
                    id="eb-etymology"
                    rows="2"
                    placeholder="可留空"
                ></textarea>
            </label>

            <label class="field">
                <span class="field-label">备注</span>

                <textarea
                    id="eb-notes"
                    rows="2"
                    placeholder="可留空"
                ></textarea>
            </label>
        </section>

    </div>


    <!-- =====================================
         Output
         ===================================== -->

    <aside class="builder-output">

        <div class="output-header">

            <div>
                <h2>生成结果</h2>

                <p>
                    生成单个词条对象，可直接加入
                    dictionary.json 的 entries 数组。
                </p>
            </div>

            <button
                id="eb-copy"
                class="copy-button"
                type="button"
                disabled
            >
                复制 JSON
            </button>

        </div>

        <div
            id="eb-validation"
            class="validation"
        ></div>

        <textarea
            id="eb-output"
            class="json-output"
            readonly
            spellcheck="false"
        ></textarea>

    </aside>

</div>


<script
    id="eb-existing-entries"
    type="application/json"
    set:html={JSON.stringify(lookupEntries)}
></script>


<style>

    .entry-builder {
        display: grid;
        grid-template-columns:
            minmax(0, 1fr)
            minmax(23rem, 0.9fr);

        gap: 1.4rem;

        margin-top: 1.5rem;
    }

    .builder-form {
        display: grid;
        gap: 1rem;
    }

    .builder-section,
    .builder-output {
        padding: 1.2rem;

